{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moraya-backend",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  // Public values only. The anon key is meant to be public.
  "vars": {
    "SUPABASE_URL": "https://YOUR-PROJECT.supabase.co",
    "SUPABASE_ANON_KEY": "YOUR-ANON-PUBLIC-KEY",
    // Browser origins allowed to call this API (comma separated). Add your deployed frontend URL.
    "ALLOWED_ORIGINS": "http://localhost:5173"
  },
  "observability": { "enabled": true }
  // SECRET (never put it here):  npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
}
