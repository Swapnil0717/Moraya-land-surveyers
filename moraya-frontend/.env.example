# Public values only (the anon key is safe in the browser).
# NEVER put the Supabase service-role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# URL of moraya-backend. Leave EMPTY in local development (Vite proxies /api to localhost:8787).
# For production set it to your deployed backend, e.g. https://moraya-backend.YOUR-SUBDOMAIN.workers.dev
VITE_API_URL=
